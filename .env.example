# Panna Biryani CRM Backend Configuration
PROJECT_NAME="Panna Biryani CRM API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="panna_super_secret_jwt_key_change_in_production_123456789"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Database: Default SQLite for local dev, MySQL in production
DATABASE_URL="sqlite:///./panna_crm.db"
# For MySQL production / local Docker:
# DATABASE_URL="mysql+pymysql://panna_user:panna_secure_pass@localhost:3306/panna_crm"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3001"]
